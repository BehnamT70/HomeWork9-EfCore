@model BookStore.Domain.Entities.Catalog.Book

@{
    ViewData["Title"] = "جزئیات کتاب";
}

<h2>اطلاعات کامل کتاب</h2>

<hr />

<dl class="row">

    <dt class="col-sm-2">شناسه</dt>
    <dd class="col-sm-10">@Model.Id</dd>

    <dt class="col-sm-2">عنوان کتاب</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">شابک (ISBN)</dt>
    <dd class="col-sm-10">@Model.ISBN</dd>

    <dt class="col-sm-2">توضیحات</dt>
    <dd class="col-sm-10">
        @(string.IsNullOrWhiteSpace(Model.Description)
            ? "توضیحاتی ثبت نشده است."
            : Model.Description)
    </dd>

    <dt class="col-sm-2">قیمت</dt>
    <dd class="col-sm-10">@Model.Price</dd>

    <dt class="col-sm-2">موجودی</dt>
    <dd class="col-sm-10">@Model.Stock</dd>

    <dt class="col-sm-2">دسته‌بندی</dt>
    <dd class="col-sm-10">
        @(Model.Category?.Name ?? "دسته‌بندی ثبت نشده است")
    </dd>

    <dt class="col-sm-2">ناشر</dt>
    <dd class="col-sm-10">
        @(Model.Publisher?.Name ?? "ناشر ثبت نشده است")
    </dd>

    <dt class="col-sm-2">نویسندگان</dt>
    <dd class="col-sm-10">
        @if (Model.BookAuthors is not null && Model.BookAuthors.Any())
        {
            @foreach (var bookAuthor in Model.BookAuthors)
            {
                <div>
                    @bookAuthor.Author.FirstName
                    @bookAuthor.Author.LastName
                </div>
            }
        }
        else
        {
            <span>نویسنده‌ای ثبت نشده است.</span>
        }
    </dd>

    <dt class="col-sm-2">تاریخ انتشار</dt>
    <dd class="col-sm-10">
        @(Model.PublishedDate?.ToString("yyyy/MM/dd") ?? "ثبت نشده است")
    </dd>

    <dt class="col-sm-2">تصویر کتاب</dt>
    <dd class="col-sm-10">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl"
                 alt="@Model.Title"
                 style="max-width: 200px; max-height: 250px;" />
        }
        else
        {
            <span>تصویری ثبت نشده است.</span>
        }
    </dd>

</dl>

<hr />

<a asp-action="Index" class="btn btn-secondary">
    بازگشت به لیست کتاب‌ها
</a>

<a asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-primary">
    ویرایش کتاب
</a>

<a asp-action="Delete"
   asp-route-id="@Model.Id"
   class="btn btn-danger">
    حذف کتاب
</a>
